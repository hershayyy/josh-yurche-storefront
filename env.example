# Required for local sign-in. SESSION_PASSWORD must be at least 32 characters.
# ADMIN_PASSWORD must be at least 8 characters.
SESSION_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required together on Vercel. Leave both empty for local file storage.
# Vercel Blob stores uploaded photos. Create a Blob store and connect it to the project.
BLOB_READ_WRITE_TOKEN=

# Postgres stores the artwork catalog and paid print orders.
# Use the Neon DATABASE_URL or Vercel Postgres POSTGRES_URL.
POSTGRES_URL=
DATABASE_URL=

# Stripe test mode only. Secret keys start with sk_test_. Live keys are rejected.
STRIPE_SECRET_KEY=

# Signing secret for /api/stripe/webhook. Locally, Stripe CLI prints this when you run:
# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Charge for one package to the contiguous United States, in US cents.
# One print uses this rate. Prints that fit the same package use it once per
# package. 1500 is $15.00. Change this to the real rate before launch.
PRINT_SHIPPING_CENTS=

# Preview deployment uses the Git branch named preview. main is reserved for
# Production. Set every name above for the Vercel Preview environment.
# Connect the Postgres and Blob stores to Preview so Vercel fills
# POSTGRES_URL and BLOB_READ_WRITE_TOKEN. Do not commit their values.
# Keep STRIPE_SECRET_KEY as a sandbox key (sk_test_ or rk_test_).
# Create the Stripe sandbox webhook on the stable preview-branch URL, then put
# that endpoint's signing secret in STRIPE_WEBHOOK_SECRET. Do not reuse the
# secret printed by `stripe listen`.
#
# https://PROJECT-git-preview-TEAM.vercel.app/api/stripe/webhook?x-vercel-protection-bypass=VERCEL_AUTOMATION_BYPASS_SECRET
#
# Vercel creates VERCEL_AUTOMATION_BYPASS_SECRET when Protection Bypass for
# Automation is enabled. Leave it out of this file and out of source control.
# The catalog copy reads .env.preview.local and does not copy orders:
# COPY_TARGET=preview npm run copy:preview

# A print ships in its own package at this rate when it cannot share.
# Sharing stops when the longer side is above PRINT_PACKAGE_MAX_INCHES,
# or when a package already holds PRINTS_PER_PACKAGE prints.
# Test values: 4 prints, 14 inches on the longer side, solo package 2500 ($25.00).
PRINT_SOLO_SHIPPING_CENTS=
PRINTS_PER_PACKAGE=
PRINT_PACKAGE_MAX_INCHES=
