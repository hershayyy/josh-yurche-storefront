# Required for local sign-in. SESSION_PASSWORD must be at least 32 characters.
# ADMIN_PASSWORD must be at least 8 characters.
SESSION_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required together on Vercel. Leave these empty for local file storage.
# Vercel Blob stores uploaded photos. An OIDC connection provides BLOB_STORE_ID
# and BLOB_WEBHOOK_PUBLIC_KEY. Vercel issues VERCEL_OIDC_TOKEN on the deployment
# and during `vercel env run`; do not copy that token into this file.
# BLOB_READ_WRITE_TOKEN is only needed for a store that is still on a static token.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# Postgres stores the artwork catalog and paid print orders.
# Use the Neon DATABASE_URL or Vercel Postgres POSTGRES_URL.
POSTGRES_URL=
DATABASE_URL=

# Stripe test mode only. Secret keys start with sk_test_. Live keys are rejected.
STRIPE_SECRET_KEY=

# Signing secret for /api/stripe/webhook. Locally, Stripe CLI prints this when you run:
# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Charge for one package to the contiguous United States, in US cents.
# One print uses this rate. Prints that fit the same package use it once per
# package. 1500 is $15.00. Change this to the real rate before launch.
PRINT_SHIPPING_CENTS=

# Preview deployment uses the Git branch named preview. main is reserved for
# Production. Set every name above for the Vercel Preview environment.
# Connect the Postgres and Blob stores to Preview. Blob OIDC fills
# BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY. Do not commit their values.
# Keep STRIPE_SECRET_KEY as a sandbox key (sk_test_ or rk_test_).
# Create the Stripe sandbox webhook on the stable preview-branch URL, then put
# that endpoint's signing secret in STRIPE_WEBHOOK_SECRET. Do not reuse the
# secret printed by `stripe listen`.
#
# https://PROJECT-git-preview-TEAM.vercel.app/api/stripe/webhook?x-vercel-protection-bypass=VERCEL_AUTOMATION_BYPASS_SECRET
#
# Vercel creates VERCEL_AUTOMATION_BYPASS_SECRET when Protection Bypass for
# Automation is enabled. Leave it out of this file and out of source control.
# The CLI cannot read the sensitive Neon URL. Pass it only for this command.
# The first run checks the destination and does not write. Add COPY_CONFIRM=preview
# after the printed host matches the hosted deployment's database branch.
# COPY_TARGET=preview COPY_DATABASE_URL='neon-url' npx vercel env run -e preview --git-branch preview -- npm run copy:preview

# A flat print ships in its own mailer at the solo rate when its longer side
# is above PRINT_PACKAGE_MAX_INCHES. Flat prints at or under that limit share
# a mailer, up to PRINTS_PER_PACKAGE.
# Rolled prints use the shorter side. PRINT_TUBE_INSIDE_INCHES is the tube's
# inside length. One inch is reserved for protective wrapping, so a 19-inch
# tube fits a shorter side of 18 inches. Rolls that fit share one tube, up to
# PRINTS_PER_PACKAGE, at the same package rate as a tube with one print.
# A rolled print with a longer shorter side needs its own longer tube.
# Test values: 4 prints, flat mailers 14 inches on the longer side,
# tube inside length 19 inches, solo mailer 2500 ($25.00).
PRINT_SOLO_SHIPPING_CENTS=
PRINTS_PER_PACKAGE=
PRINT_PACKAGE_MAX_INCHES=
PRINT_TUBE_INSIDE_INCHES=
